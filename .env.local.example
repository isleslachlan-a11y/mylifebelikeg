NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Never expose this to the client or any client component. Server-only:
# route handlers and server actions. It bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Project ref (not a secret — it's the id in your dashboard URL). Used by
# `npm run db:types` to know which project to generate src/types/database.ts
# from; the CLI itself still needs `supabase login` or SUPABASE_ACCESS_TOKEN.
SUPABASE_PROJECT_ID=your-project-ref

# Server-only: read exclusively inside src/app/api/fx/refresh/route.ts, a
# route handler, so it's never bundled to the client. Free tier at
# https://www.exchangerate-api.com/.
EXCHANGE_RATE_API_KEY=your-exchangerate-api-key

# Server-only. Lets an external scheduler (a GitHub Actions cron workflow,
# cron-job.org, etc. — anything that can set its own Authorization header;
# see CRON_SECRET below for the one route that's Vercel Cron specifically)
# call /api/fx/refresh by sending `Authorization: Bearer <this value>`.
# Optional — a signed-in user can always trigger a refresh from the
# "Refresh rates" button on /money/fx without it; only unattended/scheduled
# calls need this.
FX_REFRESH_CRON_SECRET=a-random-secret-you-generate

# Server-only. Vercel's own reserved name (P9.1) — when set, Vercel
# automatically sends it as `Authorization: Bearer $CRON_SECRET` to every
# vercel.json-declared cron endpoint, with no way to configure a different
# header from vercel.json itself. Required for
# /api/account/process-deletions (the daily account-deletion processor) to
# authenticate at all — see DEPLOYMENT.md's "Account deletion" section.
CRON_SECRET=a-different-random-secret-you-generate

# Server-only: read exclusively inside src/lib/unsplash/server.ts, itself
# only ever called from src/app/api/unsplash/*/route.ts — never bundled to
# the client. Unsplash "Access Key" from a Demo (or Production, once
# approved) app at https://unsplash.com/oauth/applications. Demo apps are
# capped at 50 requests/hour — see P6.0's caching in
# src/lib/unsplash/server.ts and src/components/unsplash/photo-picker.tsx.
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# Server-only, from the same Unsplash application page as the Access Key
# above. Not currently read anywhere in this codebase — it's only needed
# for OAuth user actions (letting someone log in with their own Unsplash
# account), which this app doesn't do — but keep it out of any
# NEXT_PUBLIC_-prefixed name regardless, the same as every other secret
# here, in case a future feature does need it.
UNSPLASH_SECRET_KEY=your-unsplash-secret-key

# Public, meant for the browser — Mapbox's own design (this is not an
# exception to CLAUDE.md rule 2, which is about the Supabase *service-role*
# key specifically). Read directly in src/components/mapbox/place-map.tsx
# to render the map itself. Create at https://account.mapbox.com/access-tokens/
# and restrict it by URL there (Vercel prod/preview domains + localhost) —
# a public token isn't a secret, but a stolen unrestricted one can still
# rack up usage against your account, and Mapbox has no hard spending cap
# (see DEPLOYMENT.md: set a billing alert).
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-public-token

# Server-only: read exclusively inside src/lib/mapbox/server.ts, itself
# only ever called from src/app/api/geocode/route.ts. A secret-scoped
# token (same dashboard as above) — kept separate from the public one
# above specifically so it can be left *without* a URL restriction (server
# calls have no browser Origin to match against a restriction anyway).
MAPBOX_SECRET_TOKEN=your-mapbox-secret-token

# P9.2. Public — Sentry DSNs are designed to be embedded in client bundles
# (they only permit *sending* events, never reading them back), so this is
# read identically by src/instrumentation-client.ts (browser),
# sentry.server.config.ts, and sentry.edge.config.ts. Entirely optional:
# every Sentry.init() call in this app is inert with no DSN set — the app
# runs completely normally, just with no error monitoring, until this is
# configured. Create a project at https://sentry.io (free tier, no card
# required) and copy its DSN from Settings → Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Server/build-only, all three optional and only used together — source
# map upload + release creation at build time (next.config.ts's
# withSentryConfig). Leaving any of these unset just skips the upload with
# a build warning, never fails the build. Auth token from
# https://sentry.io/orgredirect/organizations/:org/settings/auth-tokens/
# (needs the project:releases scope).
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Server-only: read exclusively inside src/app/api/health/route.ts. A
# *different* secret from CRON_SECRET on purpose (DEPLOYMENT.md's "Uptime
# monitoring" section explains why) — required for the route to respond at
# all; give this to whichever uptime monitor you point at
# /api/health as an `Authorization: Bearer <this value>` header.
HEALTH_CHECK_SECRET=a-third-random-secret-you-generate
