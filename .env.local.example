NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Never expose this to the client or any client component. Server-only:
# route handlers and server actions. It bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Project ref (not a secret — it's the id in your dashboard URL). Used by
# `npm run db:types` to know which project to generate src/types/database.ts
# from; the CLI itself still needs `supabase login` or SUPABASE_ACCESS_TOKEN.
SUPABASE_PROJECT_ID=your-project-ref

# Server-only: read exclusively inside src/app/api/fx/refresh/route.ts, a
# route handler, so it's never bundled to the client. Free tier at
# https://www.exchangerate-api.com/.
EXCHANGE_RATE_API_KEY=your-exchangerate-api-key

# Server-only. Lets an external scheduler (this repo has no vercel.json/
# Vercel Cron — see CLAUDE.md — so bring your own: a GitHub Actions cron
# workflow, cron-job.org, etc.) call /api/fx/refresh by sending
# `Authorization: Bearer <this value>`. Optional — a signed-in user can
# always trigger a refresh from the "Refresh rates" button on /money/fx
# without it; only unattended/scheduled calls need this.
FX_REFRESH_CRON_SECRET=a-random-secret-you-generate

# Server-only: read exclusively inside src/lib/unsplash/server.ts, itself
# only ever called from src/app/api/unsplash/*/route.ts — never bundled to
# the client. Unsplash "Access Key" from a Demo (or Production, once
# approved) app at https://unsplash.com/oauth/applications. Demo apps are
# capped at 50 requests/hour — see P6.0's caching in
# src/lib/unsplash/server.ts and src/components/unsplash/photo-picker.tsx.
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# Public, meant for the browser — Mapbox's own design (this is not an
# exception to CLAUDE.md rule 2, which is about the Supabase *service-role*
# key specifically). Read directly in src/components/mapbox/place-map.tsx
# to render the map itself. Create at https://account.mapbox.com/access-tokens/
# and restrict it by URL there (Vercel prod/preview domains + localhost) —
# a public token isn't a secret, but a stolen unrestricted one can still
# rack up usage against your account, and Mapbox has no hard spending cap
# (see DEPLOYMENT.md: set a billing alert).
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-public-token

# Server-only: read exclusively inside src/lib/mapbox/server.ts, itself
# only ever called from src/app/api/geocode/route.ts. A secret-scoped
# token (same dashboard as above) — kept separate from the public one
# above specifically so it can be left *without* a URL restriction (server
# calls have no browser Origin to match against a restriction anyway).
MAPBOX_SECRET_TOKEN=your-mapbox-secret-token
