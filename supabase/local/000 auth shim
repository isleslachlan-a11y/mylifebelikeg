-- LOCAL DEVELOPMENT ONLY. Do not apply to Supabase.
-- Supabase provides the `auth` schema, `auth.users`, `auth.uid()`, the
-- `anon`/`authenticated`/`service_role` roles, and the `storage` schema
-- for you -- all platform-managed, none of it something a real project
-- ever writes a migration for. This shim recreates just enough of each
-- to run and test the migrations against a plain Postgres instance.
--
-- P9.0: extended to cover roles and storage, not just auth -- both were
-- previously missing here, which meant "apply every migration to a
-- clean database" (CI's whole premise) silently depended on a scratch
-- Postgres instance that had these lying around from unrelated earlier
-- setup, rather than anything actually captured in this repo. The
-- baseline migration (0008_baseline_schema.sql) is full of GRANT
-- statements naming these three roles -- they have to exist before
-- that file, or every one of those GRANTs fails outright.

do $$
begin
  if not exists (select 1 from pg_roles where rolname = 'anon') then
    create role anon nologin noinherit;
  end if;
  if not exists (select 1 from pg_roles where rolname = 'authenticated') then
    create role authenticated nologin noinherit;
  end if;
  if not exists (select 1 from pg_roles where rolname = 'service_role') then
    create role service_role nologin noinherit bypassrls;
  end if;
end $$;

create schema if not exists auth;

create table if not exists auth.users (
  id            uuid primary key default gen_random_uuid(),
  email         text unique,
  created_at    timestamptz not null default now()
);

-- Mirrors Supabase's auth.uid(): reads the current request's JWT subject.
-- Locally you can impersonate a user with:
--   select set_config('request.jwt.claim.sub', '<uuid>', false);
create or replace function auth.uid()
returns uuid
language sql
stable
as $$
  select nullif(current_setting('request.jwt.claim.sub', true), '')::uuid;
$$;

-- ---------------------------------------------------------------------
-- Storage. Real Supabase Storage is a whole separate service (signed
-- URLs, a CDN, an HTTP API) -- none of that is reachable or meaningful
-- from plain SQL, and P8.7's own storage-RLS breach test already
-- verified the real thing against the real, live project (see that
-- package's own notes). What plain SQL *can* exercise, and what this
-- shim exists for, is the actual authorization boundary underneath all
-- of that: `storage.objects` is a real Postgres table with RLS
-- policies, and every one of migration 0032's four policies is nothing
-- more than a WHERE clause over `bucket_id`/`name`/`owner_id` plus
-- `storage.foldername()`. This shim is exactly enough to load and test
-- those policies directly with insert/select/update/delete as different
-- roles -- not a Storage-service replica.
create schema if not exists storage;

create table if not exists storage.buckets (
  id                  text primary key,
  name                text not null,
  public              boolean not null default false,
  file_size_limit     bigint,
  allowed_mime_types  text[],
  owner_id            text,
  created_at          timestamptz not null default now(),
  updated_at          timestamptz not null default now()
);

create table if not exists storage.objects (
  id            uuid primary key default gen_random_uuid(),
  bucket_id     text references storage.buckets(id),
  name          text,
  owner_id      text,
  created_at    timestamptz not null default now(),
  updated_at    timestamptz not null default now(),
  metadata      jsonb
);

-- Real Supabase leaves the table-level GRANT wide open and lets RLS do
-- the actual gating -- same "GRANT is coarse, RLS is the real boundary"
-- shape every table in 0008_baseline_schema.sql's own GRANT statements
-- already follows. Without this, a storage RLS test here would be
-- blocked by a bare permission error instead of actually exercising the
-- policy it's meant to test.
grant usage on schema storage to anon, authenticated, service_role;
grant all on storage.buckets, storage.objects to anon, authenticated, service_role;

alter table storage.objects enable row level security;

-- Splits a `{user_id}/{dream_id}/{uuid}.webp`-style path on '/' and
-- returns everything except the final segment -- real Supabase Storage
-- ships this exact function; every dream-photos policy (0032) calls it
-- directly.
create or replace function storage.foldername(name text)
returns text[]
language sql
immutable
as $$
  select (regexp_split_to_array(name, '/'))[1 : greatest(array_length(regexp_split_to_array(name, '/'), 1) - 1, 0)];
$$;