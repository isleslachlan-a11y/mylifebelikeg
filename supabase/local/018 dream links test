-- LOCAL ONLY. Verifies dream_entry_links (P10.3, migration 0045):
-- constraints, uniqueness, cascade delete, and the owner's own positive
-- path through all four RLS policies. Adversarial cross-user coverage
-- lives in 014 isolation test, not here -- same split this repo already
-- draws between a package's own functional suite (011 dreams test,
-- 016 sharing test, 017 friends test) and the dedicated adversarial one.
-- Run after 001 smoke test.
\set ON_ERROR_STOP on
begin;

set role authenticated;

select set_config('request.jwt.claim.sub', '11111111-1111-1111-1111-111111111111', false);

do $$
declare
  v_entry_id uuid;
  v_link_id uuid;
  n int;
begin
  insert into someday_items (user_id, title, kind)
  values ('11111111-1111-1111-1111-111111111111', 'Kyoto in autumn', 'place')
  returning id into v_entry_id;

  -- ---- a real save survives, on the owner's own path -------------------------
  insert into dream_entry_links (entry_id, user_id, provider, provider_post_id, url, canonical_url, title, note)
  values (
    v_entry_id, '11111111-1111-1111-1111-111111111111', 'instagram', 'ABC123',
    'https://www.instagram.com/p/ABC123/?igsh=xyz',
    'https://www.instagram.com/p/ABC123/',
    'Fushimi Inari at dawn', 'The one with no crowds -- go early.'
  )
  returning id into v_link_id;

  select count(*) into n from dream_entry_links where id = v_link_id and entry_id = v_entry_id;
  assert n = 1, 'a real link save should survive';

  -- ---- owner can select it -----------------------------------------------------
  select count(*) into n from dream_entry_links where entry_id = v_entry_id;
  assert n = 1, 'owner should see their own link';

  -- ---- owner can update it ------------------------------------------------------
  update dream_entry_links set note = 'Updated note.' where id = v_link_id;
  select count(*) into n from dream_entry_links where id = v_link_id and note = 'Updated note.';
  assert n = 1, 'owner should be able to update their own link';

  -- ---- (entry_id, canonical_url) uniqueness ------------------------------------
  begin
    insert into dream_entry_links (entry_id, user_id, provider, provider_post_id, url, canonical_url)
    values (v_entry_id, '11111111-1111-1111-1111-111111111111', 'instagram', 'ABC123',
            'https://instagram.com/p/ABC123', 'https://www.instagram.com/p/ABC123/');
    assert false, 'a duplicate canonical_url on the same entry should be refused';
  exception when unique_violation then null;
  end;

  -- ---- provider check constraint -------------------------------------------------
  begin
    insert into dream_entry_links (entry_id, user_id, provider, url, canonical_url)
    values (v_entry_id, '11111111-1111-1111-1111-111111111111', 'facebook',
            'https://facebook.com/x', 'https://facebook.com/x');
    assert false, 'an unsupported provider value should be refused';
  exception when check_violation then null;
  end;

  -- ---- resolve_status check constraint, and its default --------------------------
  select count(*) into n from dream_entry_links where id = v_link_id and resolve_status = 'unresolved';
  assert n = 1, 'resolve_status should default to unresolved';

  begin
    update dream_entry_links set resolve_status = 'done' where id = v_link_id;
    assert false, 'an unsupported resolve_status value should be refused';
  exception when check_violation then null;
  end;

  -- ---- P10+ placeholders stay null through this package's own writes -------------
  select count(*) into n from dream_entry_links
   where id = v_link_id and thumbnail_path is null and provider_metadata is null and resolved_at is null;
  assert n = 1, 'thumbnail_path/provider_metadata/resolved_at should stay null -- this package never populates them';

  -- ---- url/canonical_url cannot be blank -----------------------------------------
  begin
    insert into dream_entry_links (entry_id, user_id, provider, url, canonical_url)
    values (v_entry_id, '11111111-1111-1111-1111-111111111111', 'other', '   ', 'https://example.com');
    assert false, 'a blank url should be refused';
  exception when check_violation then null;
  end;

  -- ---- cascade delete: removing the dream removes its links -----------------------
  delete from someday_items where id = v_entry_id;
  select count(*) into n from dream_entry_links where entry_id = v_entry_id;
  assert n = 0, 'deleting a dream should cascade-delete its links';

  -- ---- owner can delete a link directly, too (fresh fixture) -----------------------
  insert into someday_items (user_id, title, kind) values
    ('11111111-1111-1111-1111-111111111111', 'Another dream', 'object')
  returning id into v_entry_id;
  insert into dream_entry_links (entry_id, user_id, provider, url, canonical_url)
  values (v_entry_id, '11111111-1111-1111-1111-111111111111', 'other', 'https://example.com/x', 'https://example.com/x')
  returning id into v_link_id;

  delete from dream_entry_links where id = v_link_id;
  select count(*) into n from dream_entry_links where id = v_link_id;
  assert n = 0, 'owner should be able to delete their own link';
end $$;

-- ---- insert refuses attaching a link to someone else's *real* entry_id -----------
-- ("a user cannot attach a link to someone else's entry by guessing an
-- id", brief verbatim) -- deliberately a real id belonging to B, not a
-- fabricated/nonexistent one: a nonexistent id would also fail the
-- entry_id foreign key, which proves nothing about the RLS check this
-- is actually meant to exercise. The cross-user *read* paths are 014's
-- job; this specific write-time guess-the-id attempt belongs here since
-- it's the insert policy's own guarantee, not a general isolation sweep.
select set_config('request.jwt.claim.sub', '22222222-2222-2222-2222-222222222222', false);
do $$
declare v_b_entry_id uuid;
begin
  insert into someday_items (user_id, title, kind)
  values ('22222222-2222-2222-2222-222222222222', 'B''s own dream', 'object')
  returning id into v_b_entry_id;
  perform set_config('request.jwt.claim.sub', '11111111-1111-1111-1111-111111111111', true);

  begin
    insert into dream_entry_links (entry_id, user_id, provider, url, canonical_url)
    values (v_b_entry_id, '11111111-1111-1111-1111-111111111111', 'other',
            'https://example.com/y', 'https://example.com/y');
    assert false, 'A attaching a link to B''s real entry_id should be refused';
  exception when insufficient_privilege then null;
  end;
end $$;

rollback;
select 'DREAM ENTRY LINKS VERIFIED' as result;
