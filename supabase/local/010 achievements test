-- LOCAL ONLY. Verifies achievement evaluation and avatar unlock enforcement.
-- Run after 001_smoke_test.sql.
\set ON_ERROR_STOP on
begin;

select set_config('request.jwt.claim.sub', '11111111-1111-1111-1111-111111111111', false);

-- ---- nothing unlocked to start ----------------------------------------------
do $$
declare n int;
begin
  select count(*) into n from user_achievements
   where user_id = '11111111-1111-1111-1111-111111111111';
  assert n = 0, format('expected a clean slate, found %s', n);
end $$;

-- ---- first goal completed unlocks First Light --------------------------------
-- The London move goal, seeded and committed by 001 smoke test (there is
-- no ...002 goal anywhere in the fixture set — a pre-existing typo here
-- meant this update matched zero rows and the achievement never fired;
-- found by actually running the suite against a fresh database, not by
-- reading the assertion and assuming it passed).
do $$
declare n int;
begin
  update goals set state = 'completed', completed_at = now()
   where id = 'bbbbbbbb-0000-0000-0000-000000000001';

  perform app.evaluate_achievements('11111111-1111-1111-1111-111111111111');

  select count(*) into n
  from user_achievements ua join achievements ac on ac.id = ua.achievement_id
  where ua.user_id = '11111111-1111-1111-1111-111111111111' and ac.code = 'first_light';
  assert n = 1, 'First Light should unlock on the first completed goal';
end $$;

-- ---- idempotent --------------------------------------------------------------
do $$
declare n int; newly int;
begin
  select count(*) into newly from app.evaluate_achievements('11111111-1111-1111-1111-111111111111');
  assert newly = 0, format('re-evaluating should unlock nothing new, got %s', newly);

  -- Completing that goal on time and under budget also qualifies for
  -- on_the_money, so more than one may have fired. What matters is that
  -- re-evaluating grants nothing further.
  select count(*) into n from user_achievements
   where user_id = '11111111-1111-1111-1111-111111111111';
  assert n >= 1, format('should hold at least 1 achievement, got %s', n);
end $$;

-- ---- context is recorded -----------------------------------------------------
do $$
declare ua record;
begin
  select ua2.* into ua from user_achievements ua2
  join achievements ac on ac.id = ua2.achievement_id
  where ua2.user_id = '11111111-1111-1111-1111-111111111111' and ac.code = 'first_light';
  assert (ua.context->>'count')::int >= 1, 'context should record the qualifying count';
end $$;

-- ---- unlocking makes presets available --------------------------------------
do $$
declare p record;
begin
  select * into p from v_available_presets where code = 'pose_celebrating';
  assert p.is_unlocked, 'pose_celebrating should be unlocked by first_light';

  select * into p from v_available_presets where code = 'outfit_explorer';
  assert not p.is_unlocked, 'outfit_explorer requires first_departure';
  assert p.unlock_hint is not null, 'a locked preset should say how to get it';
end $$;

-- free presets are available with no achievements at all
select set_config('request.jwt.claim.sub', '22222222-2222-2222-2222-222222222222', false);
do $$
declare n int;
begin
  select count(*) into n from v_available_presets where category = 'outfit' and is_unlocked;
  assert n >= 4, format('every user needs starter outfits, got %s', n);

  select count(*) into n from v_available_presets where category = 'base' and is_unlocked;
  assert n >= 4, format('every user needs starter bases, got %s', n);
end $$;

-- ---- avatar validation -------------------------------------------------------
select set_config('request.jwt.claim.sub', '11111111-1111-1111-1111-111111111111', false);

-- a valid free combination is accepted
do $$
begin
  update profiles
     set avatar = '{"base":"base_1","outfit":"outfit_hoodie","pose":"pose_standing"}'::jsonb
   where id = '11111111-1111-1111-1111-111111111111';
end $$;

-- an unlocked preset is accepted
do $$
begin
  update profiles
     set avatar = jsonb_set(avatar, '{pose}', '"pose_celebrating"')
   where id = '11111111-1111-1111-1111-111111111111';
end $$;

-- a LOCKED preset is refused
do $$
begin
  begin
    update profiles set avatar = jsonb_set(avatar, '{outfit}', '"outfit_explorer"')
     where id = '11111111-1111-1111-1111-111111111111';
    assert false, 'LEAK: a locked outfit was equipped';
  exception when insufficient_privilege then null;
  end;
end $$;

-- a preset in the wrong slot is refused
do $$
begin
  begin
    update profiles set avatar = jsonb_set(avatar, '{outfit}', '"pose_standing"')
     where id = '11111111-1111-1111-1111-111111111111';
    assert false, 'a pose should not be equippable as an outfit';
  exception when check_violation then null;
  end;
end $$;

-- an unknown slot is refused
do $$
begin
  begin
    update profiles set avatar = jsonb_set(avatar, '{hat}', '"base_1"')
     where id = '11111111-1111-1111-1111-111111111111';
    assert false, 'unknown avatar slot should be refused';
  exception when check_violation then null;
  end;
end $$;

-- an unknown preset code is refused
do $$
begin
  begin
    update profiles set avatar = jsonb_set(avatar, '{base}', '"base_does_not_exist"')
     where id = '11111111-1111-1111-1111-111111111111';
    assert false, 'unknown preset code should be refused';
  exception when check_violation then null;
  end;
end $$;

-- ---- pin limit ---------------------------------------------------------------
do $$
declare ids uuid[]; i int;
begin
  -- grant three more achievements directly so there are four to pin
  insert into user_achievements (user_id, achievement_id)
  select '11111111-1111-1111-1111-111111111111', id
  from achievements where code in ('constellation','steady_hand','on_the_money','long_haul')
  on conflict (user_id, achievement_id) do nothing;

  select array_agg(id) into ids from user_achievements
   where user_id = '11111111-1111-1111-1111-111111111111';

  for i in 1..3 loop
    update user_achievements set is_pinned = true where id = ids[i];
  end loop;

  begin
    update user_achievements set is_pinned = true where id = ids[4];
    assert false, 'should not be able to pin a fourth achievement';
  exception when check_violation then null;
  end;
end $$;

-- ---- streak-based achievement -----------------------------------------------
do $$
declare p record; i int; n int;
begin
  delete from check_ins where user_id = '11111111-1111-1111-1111-111111111111';
  select * into p from app.current_checkin_period('11111111-1111-1111-1111-111111111111');
  for i in 1..4 loop
    insert into check_ins (user_id, period_start, period_end, submitted_at)
    values ('11111111-1111-1111-1111-111111111111',
            p.period_start - (7*i), p.period_end - (7*i), now());
  end loop;

  perform app.evaluate_achievements('11111111-1111-1111-1111-111111111111');

  select count(*) into n
  from user_achievements ua join achievements ac on ac.id = ua.achievement_id
  where ua.user_id = '11111111-1111-1111-1111-111111111111' and ac.code = 'steady_hand';
  assert n = 1, 'Steady Hand should unlock at a 4-week streak';
end $$;

-- ---- presets_unlocked_by -----------------------------------------------------
do $$
declare n int;
begin
  select count(*) into n from app.presets_unlocked_by(
    '11111111-1111-1111-1111-111111111111', 'first_departure');
  assert n = 2, format('first_departure should unlock 2 presets, got %s', n);
end $$;

-- ---- cannot grant to another user -------------------------------------------
do $$
begin
  begin
    perform app.grant_achievement('22222222-2222-2222-2222-222222222222', 'first_light');
    assert false, 'should not be able to grant an achievement to another user';
  exception when insufficient_privilege then null;
  end;
end $$;

rollback;
select 'ACHIEVEMENTS AND AVATARS VERIFIED' as result;