-- ---- RAG ---------------------------------------------------------------------
select 'RAG for the London move:' as label;
select schedule_status, budget_status, momentum_status, overall_status,
       schedule_variance_pp, budget_variance_pp, momentum_mean
from app.compute_goal_rag('bbbbbbbb-0000-0000-0000-000000000001');

do $$
declare r record;
begin
  select * into r from app.compute_goal_rag('bbbbbbbb-0000-0000-0000-000000000001');

  -- 30 of 130 duration-weighted days done, 50% elapsed -> ~-27pp -> red
  assert r.schedule_status = 'red', format('schedule expected red, got %s', r.schedule_status);

  -- contributed 3,000 GBP against ~7,500 required to date -> ~40% -> red
  assert r.budget_status = 'red', format('budget expected red, got %s', r.budget_status);

  -- mean of 4,2,4 = 3.33 -> amber
  assert r.momentum_status = 'amber', format('momentum expected amber, got %s', r.momentum_status);
  assert r.momentum_mean = 3.33, format('momentum mean wrong: %s', r.momentum_mean);

  -- worst wins
  assert r.overall_status = 'red', format('overall expected red, got %s', r.overall_status);
end $$;

