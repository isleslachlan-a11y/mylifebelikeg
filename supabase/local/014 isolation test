-- =============================================================================
-- PART 0: schema coverage enumeration. The single most valuable line in
-- this package (brief, verbatim) -- a table or view added later without
-- a matching block below fails this suite, not silently passes it.
-- Runs before any role switch (information_schema doesn't care who's
-- asking, and this has to work as-is for anyone who ever runs this file).
-- =============================================================================
do $$
declare
  v_row record;
  v_uncovered text[] := '{}';
  -- Every table and view this suite actually exercises below, by name.
  -- Keep this list and the assertions beneath it in sync -- that's the
  -- whole point of the check.
  v_covered text[] := array[
    -- tables
    'achievements', 'avatar_presets', 'capacity_suggestion_dismissals',
    'cashflow_items', 'check_ins', 'fx_rates', 'goal_participants',
    'goal_ratings', 'goals', 'invitations', 'ledger_entries', 'life_areas',
    'llama_messages', 'milestones', 'pots', 'profiles',
    'rag_override_history', 'rag_snapshots', 'share_grants',
    'someday_items', 'task_dependencies', 'tasks', 'trip_legs',
    'trip_stops', 'trips', 'user_achievements',
    -- views
    'v_allocation_summary', 'v_available_presets', 'v_checkin_streak',
    'v_countries_visited', 'v_critical_path', 'v_dream_affordability',
    'v_dream_prune_candidates', 'v_financial_horizon',
    'v_goal_affordability', 'v_goal_funding', 'v_goal_projected_end',
    'v_goal_rag', 'v_goal_rating_trend', 'v_monthly_capacity',
    'v_monthly_cashflow', 'v_pot_balances', 'v_rating_divergence',
    'v_someday_progress', 'v_timeline_items', 'v_trip_estimates',
    'v_user_capacity'
  ];
begin
  for v_row in
    select table_name from information_schema.tables
    where table_schema = 'public' and table_type in ('BASE TABLE', 'VIEW')
  loop
    if not (v_row.table_name = any(v_covered)) then
      v_uncovered := v_uncovered || v_row.table_name;
    end if;
  end loop;
  assert array_length(v_uncovered, 1) is null,
    format('UNCOVERED by the isolation suite (add assertions, then add to v_covered): %s', v_uncovered);
end $$;

-- Every security_invoker view, asserted as a schema check -- "a view can
-- appear to behave correctly while the flag is missing" (brief,
-- verbatim; 0038 is exactly that case, found by this exact check).
do $$
declare
  v_row record;
  v_missing text[] := '{}';
begin
  for v_row in
    select c.relname
    from pg_class c join pg_namespace n on n.oid = c.relnamespace
    where n.nspname = 'public' and c.relkind = 'v'
  loop
    if not exists (
      select 1
      from pg_class c2 join pg_namespace n2 on n2.oid = c2.relnamespace
      where n2.nspname = 'public' and c2.relname = v_row.relname
        and c2.reloptions is not null
        and 'security_invoker=true' = any(c2.reloptions)
    ) then
      v_missing := v_missing || v_row.relname;
    end if;
  end loop;
  assert array_length(v_missing, 1) is null,
    format('view(s) missing security_invoker=true: %s', v_missing);
end $$;

