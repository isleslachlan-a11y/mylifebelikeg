select set_config('request.jwt.claim.sub', '55555555-5555-5555-5555-555555555555', false);

-- =============================================================================
-- PART 5: the share grant. C reads the granted goal and gets it. C
-- reads A's other goal and gets nothing. C reads A's ledger, check-ins
-- and dreams and gets nothing beyond what the grant covers (0037's own
-- decision: a goal-level grant unlocks the bare goals row only). C
-- cannot write to the granted goal, regardless of the grant's scope --
-- that's the explicit, asserted decision this package makes rather than
-- discovering later.
-- =============================================================================
select set_config('request.jwt.claim.sub', '33333333-3333-3333-3333-333333333333', false);

do $$
declare n int;
begin
  select count(*) into n from goals where id = 'a0000000-0000-0000-0000-000000000010';
  assert n = 1, 'C should see the granted goal, saw none';

  select count(*) into n from goals where id = 'a0000000-0000-0000-0000-000000000011';
  assert n = 0, 'LEAK: C sees A''s other (ungranted) goal';

  -- Beyond the bare row: nothing. The grant does not cascade to tasks,
  -- milestones, ledger, check-ins, ratings, RAG, or dreams -- that's
  -- goal_participants' job, which C does not have.
  select count(*) into n from tasks where goal_id = 'a0000000-0000-0000-0000-000000000010';
  assert n = 0, 'LEAK: C sees tasks via a bare goal grant';
  select count(*) into n from milestones where goal_id = 'a0000000-0000-0000-0000-000000000010';
  assert n = 0, 'LEAK: C sees milestones via a bare goal grant';
  select count(*) into n from ledger_entries where goal_id in ('a0000000-0000-0000-0000-000000000010','a0000000-0000-0000-0000-000000000011');
  assert n = 0, 'LEAK: C sees A''s ledger via the goal grant';
  select count(*) into n from check_ins where id = 'a0000000-0000-0000-0000-000000000040';
  assert n = 0, 'LEAK: C sees A''s check-ins via the goal grant';
  select count(*) into n from goal_ratings where goal_id in ('a0000000-0000-0000-0000-000000000010','a0000000-0000-0000-0000-000000000011');
  assert n = 0, 'LEAK: C sees A''s goal ratings via the goal grant';
  select count(*) into n from rag_snapshots where goal_id in ('a0000000-0000-0000-0000-000000000010','a0000000-0000-0000-0000-000000000011');
  assert n = 0, 'LEAK: C sees A''s RAG snapshots via the goal grant';
  select count(*) into n from someday_items where user_id = '44444444-4444-4444-4444-444444444444';
  assert n = 0, 'LEAK: C sees A''s dreams via the (unrelated) goal grant';
  select count(*) into n from pots where user_id = '44444444-4444-4444-4444-444444444444';
  assert n = 0, 'LEAK: C sees A''s pots via the goal grant';
end $$;

do $$
begin
  -- Write: explicitly decided and asserted, not discovered later. A
  -- view-scope grant on a goal never unlocks goals_update -- that stays
  -- goal_participants' job.
  update goals set title = 'C was here' where id = 'a0000000-0000-0000-0000-000000000010';
  assert (select count(*) from goals where id = 'a0000000-0000-0000-0000-000000000010' and title = 'C was here') = 0,
    'DECISION VIOLATED: a goal-level share grant should never allow writing to the goal';
