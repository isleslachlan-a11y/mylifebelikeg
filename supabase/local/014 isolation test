-- =============================================================================
-- PART 4: every function callable from the client, called as B with A's
-- own IDs as arguments. Security-definer functions bypass RLS by
-- design -- any that hands back A's data, or lets B mutate A's rows, is
-- a defect regardless of what the table-level RLS above already proved.
-- =============================================================================
do $$
declare v_result uuid; v_date date; v_dream uuid;
begin
  -- Ownership-checked mutators: each should refuse outright (raise) when
  -- given a resource id that isn't B's.
  begin
    perform preview_task_slip('a0000000-0000-0000-0000-000000000021', 5);
    assert false, 'LEAK: B previewed a slip on A''s task';
  exception when others then null;
  end;

  begin
    perform promote_dream_to_goal('a0000000-0000-0000-0000-000000000050');
    assert false, 'LEAK: B promoted A''s dream to a goal';
  exception when others then null;
  end;

  begin
    perform snooze_dream('a0000000-0000-0000-0000-000000000050');
    assert false, 'LEAK: B snoozed A''s dream';
  exception when others then null;
  end;

  begin
    perform reorder_trip_stop('a0000000-0000-0000-0000-0000000000a1', 0);
    assert false, 'LEAK: B reordered A''s trip stop';
  exception when others then null;
  end;

  begin
    perform promote_someday_to_stop('a0000000-0000-0000-0000-000000000050', 'a0000000-0000-0000-0000-0000000000a0', 1);
    assert false, 'LEAK: B promoted A''s dream into A''s trip';
  exception when others then null;
  end;

  -- surface_dream_for_checkin takes a check_in_id -- B's own call with
  -- A's check-in id should refuse (not authorized), not silently no-op.
  begin
    perform surface_dream_for_checkin('a0000000-0000-0000-0000-000000000040');
    assert false, 'LEAK: B surfaced a dream against A''s check-in';
  exception when others then null;
  end;

  -- These take no target id at all -- pinned to auth.uid() internally
  -- (public.*'s own wrapper shape, see CLAUDE.md) -- calling them as B
  -- must only ever be able to affect/return B's own state, never A's.
  perform ensure_current_checkin();
  perform evaluate_achievements();
  perform grant_achievement('first_light');
  perform suggest_goal_limit_change();
  perform current_checkin_period();
  perform presets_unlocked_by('first_light');

  -- create_trip_goal always creates a *new* goal owned by the caller --
  -- there's no A-owned id to pass in, so the adversarial case here is
  -- simply confirming it can't be pointed at anyone else's data; it
  -- takes no foreign id at all, so it has no such surface to test
  -- beyond what INSERT-level RLS on goals already covers (PART 2).
end $$;

-- Checked as the unrestricted role, not as B: B's own SELECT already
-- can't see A's rows at all (that's PART 2/3's job), so re-checking
-- "unchanged" through B's own restricted view would trivially read
