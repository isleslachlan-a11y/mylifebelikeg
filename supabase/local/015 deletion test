-- LOCAL ONLY. P9.1: "test in 015 [the brief said 011, already taken --
-- see 014's own header for why numbering here isn't gapless]: delete
-- user A, then assert zero rows remaining across every enumerated
-- table, zero objects under the prefix, no auth.users row, and user
-- B's data untouched. Reuse the schema enumeration from P9.0 so a new
-- table is covered by deletion automatically" (brief, verbatim).
--
-- "Reuse the schema enumeration" is done one step stronger here than
-- 014's own PART 0: instead of a hand-maintained list of table names
-- that has to be remembered on every new table (014's own approach,
-- fine for an RLS suite where "is this table covered by a policy" has
-- no mechanical source of truth), PART 0 below queries
-- `pg_constraint` for every foreign key that references
-- `public.profiles(id)`, anywhere in the schema. That list *is* the
-- exact set of places a deleted user's id could still be lurking after
-- deletion, mechanically, so a table added later with a `user_id`/
-- `owner_id`/etc. column referencing profiles is automatically in
-- scope the moment its migration adds the FK -- no second edit to this
-- file required. A cross-check against `information_schema.columns`
-- (does every *plausibly-named* person column have a matching FK in
-- that set?) catches the one gap this can't self-detect: a column
-- named like an owner column that was never actually given a real FK.
--
-- Assumes 000 auth shim has already been applied. Wrapped in its own
-- begin/rollback (014's own convention) so this suite -- which really
-- does delete an `auth.users` row -- leaves nothing behind.
\set ON_ERROR_STOP on

-- =============================================================================
-- PART 0: FK-derived coverage. Every (table, column) that references
-- profiles(id), enumerated from the catalog, not typed out by hand.
-- =============================================================================
do $$
declare
  v_row record;
  v_fk_covered text[] := '{}';
  v_name_covered text[] := '{}';
  v_gap text[] := '{}';
begin
  -- The real, mechanical source of truth: every FK onto profiles(id).
  for v_row in
    select conrelid::regclass::text as table_name, a.attname as column_name
    from pg_constraint c
    join pg_attribute a on a.attrelid = c.conrelid and a.attnum = any(c.conkey)
    where c.contype = 'f' and c.confrelid = 'public.profiles'::regclass
  loop
    v_fk_covered := v_fk_covered || format('%s.%s', v_row.table_name, v_row.column_name);
  end loop;

  assert array_length(v_fk_covered, 1) >= 20,
    format('expected at least 20 FKs onto profiles(id), found %s -- did the catalog query break?', array_length(v_fk_covered, 1));

  -- Sanity cross-check: any column that *looks* like a person reference
  -- (by name) but has no real FK in the set above is a gap worth
  -- knowing about -- either it should have a real FK, or it's a
  -- deliberate non-FK reference this suite needs to know to check by
  -- hand instead.
  for v_row in
    select c.table_name, c.column_name
    from information_schema.columns c
    join information_schema.tables t
      on t.table_schema = c.table_schema and t.table_name = c.table_name
    where c.table_schema = 'public'
      and t.table_type = 'BASE TABLE'
      and c.column_name in (
        'user_id', 'owner_id', 'grantor_id', 'grantee_id', 'inviter_id',
        'invitee_id', 'set_by', 'revoked_by', 'invited_by', 'accepted_by',
        'rag_override_by'
      )
  loop
    v_name_covered := v_name_covered || format('%s.%s', v_row.table_name, v_row.column_name);
    if not (format('%s.%s', v_row.table_name, v_row.column_name) = any(v_fk_covered)) then
      v_gap := v_gap || format('%s.%s', v_row.table_name, v_row.column_name);
    end if;
  end loop;

  assert array_length(v_gap, 1) is null,
    format('person-shaped column(s) with no real FK onto profiles -- add a real FK, or a manual check in this suite: %s', v_gap);
end $$;

