-- =============================================================================
-- PART 2: negative check first -- public.prepare_user_deletion refuses
-- for anyone but service_role. Confirmed against the real GUC-based
-- check, not `current_user` (see 0041's own comment for why the
-- obvious-looking `current_user` version is actually always wrong
-- inside a SECURITY DEFINER function).
-- =============================================================================
select set_config('request.jwt.claim.role', 'authenticated', false);
set role authenticated;
select set_config('request.jwt.claim.sub', '66666666-6666-6666-6666-666666666666', false);
do $$
begin
  begin
    perform public.prepare_user_deletion('66666666-6666-6666-6666-666666666666');
