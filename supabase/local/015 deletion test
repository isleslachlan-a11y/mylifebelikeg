declare n int; v_owner uuid; v_invited_by uuid;
begin
  select count(*) into n from profiles where id = '77777777-7777-7777-7777-777777777777';
  assert n = 1, 'B''s profile should be untouched';

  select count(*) into n from pots where id = 'b0000000-0000-0000-0000-0000000000b0';
  assert n = 1, 'B''s pot should be untouched';

  select count(*) into n from goals where id = 'b0000000-0000-0000-0000-0000000000b1';
  assert n = 1, 'B''s goal should be untouched';

  -- The task A used to own on B's goal: still exists, now B's.
  select owner_id into v_owner from tasks where id = 'b0000000-0000-0000-0000-0000000000b3';
  assert v_owner = '77777777-7777-7777-7777-777777777777', 'B''s goal''s task should survive, reassigned to B';

  -- goal_participants: A's own row (user_id = A) is gone via CASCADE;
  -- B's own participation isn't affected at all (B never participated
  -- in their own goal via goal_participants -- ownership is via
  -- goals.owner_id, not this table).
  select count(*) into n from goal_participants where id = 'b0000000-0000-0000-0000-0000000000b2';
  assert n = 0, 'A''s participant row on B''s goal should be gone (goal_participants.user_id is CASCADE)';

  -- The invitation A sent to B: gone via CASCADE (inviter_id), which
  -- is correct and expected -- not a leak, just confirming the shape.
  select count(*) into n from invitations where id = 'b0000000-0000-0000-0000-0000000000b5';
  assert n = 0, 'A''s invitation to B should be gone along with A (inviter_id is CASCADE)';
end $$;

