-- =============================================================================
-- PART 3: prepare, then delete auth.users -- the same two-step order
-- src/app/api/account/process-deletions/route.ts uses (storage wipe
-- happens between them there; simulated directly on storage.objects
-- here, since the real recursive Storage-API listing is Next.js-side
-- logic this plain-SQL suite can't reach -- same scoping note 014's own
-- PART 6 makes about the real Storage HTTP API being covered
-- separately, live, in P8.7's breach test).
-- =============================================================================
select set_config('request.jwt.claim.role', 'service_role', false);
set role service_role;

-- Storage: list-then-remove-then-verify, same shape as
-- wipeUserStorage() in the real route.
do $$
declare v_remaining int;
begin
  delete from storage.objects where owner_id = '66666666-6666-6666-6666-666666666666';
  select count(*) into v_remaining from storage.objects where owner_id = '66666666-6666-6666-6666-666666666666';
  assert v_remaining = 0, format('storage objects survived removal: %s', v_remaining);
end $$;

select public.prepare_user_deletion('66666666-6666-6666-6666-666666666666');

-- Confirm the reassignment/delete split worked exactly as
-- 0041 documents, before the auth cascade even runs.
do $$
declare n int; v_owner uuid;
begin
  -- A's own task, on A's own goal: deleted outright (RESTRICT, no
  -- grace period even within the same eventual cascade).
  select count(*) into n from tasks where id = 'b0000000-0000-0000-0000-000000000020';
  assert n = 0, 'A''s self-owned task should already be gone after prepare_user_deletion';

  -- A's own override, on A's own goal: deleted outright (NO ACTION,
  -- also no grace period in practice -- see 0041's own corrected note).
  select count(*) into n from rag_override_history where id = 'b0000000-0000-0000-0000-000000000021';
  assert n = 0, 'A''s self-owned override should already be gone after prepare_user_deletion';

  -- A's task on B's goal: survives, reassigned to B (the goal's real owner).
  select owner_id into v_owner from tasks where id = 'b0000000-0000-0000-0000-0000000000b3';
  assert v_owner = '77777777-7777-7777-7777-777777777777', 'A''s task on B''s goal should be reassigned to B, not deleted';

  -- A's override on B's goal: survives, reassigned to B.
  select set_by into v_owner from rag_override_history where id = 'b0000000-0000-0000-0000-0000000000b4';
  assert v_owner = '77777777-7777-7777-7777-777777777777', 'A''s override on B''s goal should be reassigned to B, not deleted';
end $$;

-- The actual removal -- what auth.admin.deleteUser() does under the
-- hood in production; a plain DELETE against auth.users is the
-- faithful local proxy for it, since the cascade this suite cares
-- about is entirely a Postgres-level FK property, not something the
-- Admin API itself adds on top.
delete from auth.users where id = '66666666-6666-6666-6666-666666666666';

reset role;

-- =============================================================================
-- PART 4: the actual acceptance check -- zero rows remaining across
-- every FK-derived table/column from PART 0, zero storage objects, no
-- auth.users row, and B completely untouched.
-- =============================================================================
do $$
declare
  v_row record;
  v_leftover text[] := '{}';
  v_count bigint;
begin
  for v_row in
    select conrelid::regclass::text as table_name, a.attname as column_name
    from pg_constraint c
    join pg_attribute a on a.attrelid = c.conrelid and a.attnum = any(c.conkey)
    where c.contype = 'f' and c.confrelid = 'public.profiles'::regclass
  loop
    execute format(
      'select count(*) from %s where %I = $1',
      v_row.table_name, v_row.column_name
    ) into v_count using '66666666-6666-6666-6666-666666666666'::uuid;
    if v_count > 0 then
      v_leftover := v_leftover || format('%s.%s (%s row(s))', v_row.table_name, v_row.column_name, v_count);
    end if;
  end loop;
  assert array_length(v_leftover, 1) is null,
    format('rows still reference deleted user A after deletion: %s', v_leftover);
end $$;

do $$
declare n int;
begin
  select count(*) into n from profiles where id = '66666666-6666-6666-6666-666666666666';
  assert n = 0, 'A''s profile row should be gone';

  select count(*) into n from auth.users where id = '66666666-6666-6666-6666-666666666666';
  assert n = 0, 'A''s auth.users row should be gone -- an orphaned auth record blocks reusing the email';

  select count(*) into n from storage.objects where owner_id = '66666666-6666-6666-6666-666666666666';
  assert n = 0, 'A''s storage objects should be gone';

  select count(*) into n from storage.objects where name like '66666666-6666-6666-6666-666666666666/%';
  assert n = 0, 'A''s storage objects (by path prefix) should be gone';

  -- The email is genuinely free to reuse -- nothing in auth.users or
  -- profiles still claims it.
  select count(*) into n from auth.users where email = 'del-a@example.com';
  assert n = 0, 'A''s email should be free to reuse';
end $$;

-- B: untouched. Not just "still exists" -- the exact rows and values
-- from PART 1, confirming deletion never reached past what it should.
