-- LOCAL ONLY. Verifies trip stop derivation, reordering and promotion.
-- Run after 001_smoke_test.sql.
\set ON_ERROR_STOP on
begin;

-- app.reorder_trip_stop and promote check auth.uid(); impersonate the owner.
select set_config('request.jwt.claim.sub', '11111111-1111-1111-1111-111111111111', false);

-- The smoke test created the Japan trip (goal ...004, trip ...001) with
-- Tokyo(5), Kyoto(4), Osaka(3) at sequences 0,1,2 -- though 001 reorders them.
-- Rebuild a known state.
delete from trip_stops where trip_id = 'eeeeeeee-0000-0000-0000-000000000001';

update goals set start_date = current_date + 200, target_date = current_date + 220
 where id = 'bbbbbbbb-0000-0000-0000-000000000004';

insert into trip_stops (id, trip_id, sequence, name, nights, country_code) values
  ('11110000-0000-0000-0000-000000000001', 'eeeeeeee-0000-0000-0000-000000000001', 0, 'Tokyo', 5, 'JP'),
  ('11110000-0000-0000-0000-000000000002', 'eeeeeeee-0000-0000-0000-000000000001', 1, 'Kyoto', 4, 'JP'),
  ('11110000-0000-0000-0000-000000000003', 'eeeeeeee-0000-0000-0000-000000000001', 2, 'Osaka', 3, 'JP');

-- ---- derivation --------------------------------------------------------------
do $$
declare a record; b record; c record; v_start date;
begin
  select start_date into v_start from goals where id = 'bbbbbbbb-0000-0000-0000-000000000004';
  select * into a from trip_stops where id = '11110000-0000-0000-0000-000000000001';
  select * into b from trip_stops where id = '11110000-0000-0000-0000-000000000002';
  select * into c from trip_stops where id = '11110000-0000-0000-0000-000000000003';

  assert a.computed_arrival = v_start,     format('Tokyo arrival: %s', a.computed_arrival);
  assert a.computed_departure = v_start+5, format('Tokyo departure: %s', a.computed_departure);
  assert b.computed_arrival = v_start+5,   format('Kyoto arrival: %s', b.computed_arrival);
  assert b.computed_departure = v_start+9, format('Kyoto departure: %s', b.computed_departure);
  assert c.computed_arrival = v_start+9,   format('Osaka arrival: %s', c.computed_arrival);
  assert c.computed_departure = v_start+12,format('Osaka departure: %s', c.computed_departure);
end $$;

-- ---- changing nights ripples -------------------------------------------------
do $$
declare c record; v_start date;
begin
  update trip_stops set nights = 8 where id = '11110000-0000-0000-0000-000000000001';
  select start_date into v_start from goals where id = 'bbbbbbbb-0000-0000-0000-000000000004';
  select * into c from trip_stops where id = '11110000-0000-0000-0000-000000000003';
  assert c.computed_arrival = v_start + 12,
    format('adding 3 nights to Tokyo should push Osaka to +12, got %s', c.computed_arrival);
  update trip_stops set nights = 5 where id = '11110000-0000-0000-0000-000000000001';
end $$;

-- ---- reordering --------------------------------------------------------------
do $$
declare a record; b record; v_start date;
begin
  -- Move Osaka (seq 2) to the front.
  perform app.reorder_trip_stop('11110000-0000-0000-0000-000000000003', 0);

  select start_date into v_start from goals where id = 'bbbbbbbb-0000-0000-0000-000000000004';
  select * into a from trip_stops where id = '11110000-0000-0000-0000-000000000003';
  select * into b from trip_stops where id = '11110000-0000-0000-0000-000000000001';

  assert a.sequence = 0, format('Osaka should be first, seq %s', a.sequence);
  assert a.computed_arrival = v_start, 'Osaka should now arrive on day 0';
  assert b.sequence = 1, format('Tokyo should be second, seq %s', b.sequence);
  assert b.computed_arrival = v_start + 3, format('Tokyo should follow Osaka 3 nights: %s', b.computed_arrival);
end $$;

-- sequences stay contiguous with no duplicates
do $$
declare n int; mx int;
begin
  select count(*), max(sequence) into n, mx from trip_stops
   where trip_id = 'eeeeeeee-0000-0000-0000-000000000001' and deleted_at is null;
  assert mx = n - 1, format('sequences should be 0..%s, max is %s', n-1, mx);

  select count(*) into n from (
    select sequence from trip_stops
     where trip_id = 'eeeeeeee-0000-0000-0000-000000000001' and deleted_at is null
     group by sequence having count(*) > 1
  ) d;
  assert n = 0, 'duplicate sequences after reorder';
end $$;

-- move back
do $$ begin perform app.reorder_trip_stop('11110000-0000-0000-0000-000000000003', 2); end $$;

-- ---- goal start cascade ------------------------------------------------------
do $$
declare before_d date; after_d date;
begin
  select computed_arrival into before_d from trip_stops where id = '11110000-0000-0000-0000-000000000002';
  update goals set start_date = start_date + 14 where id = 'bbbbbbbb-0000-0000-0000-000000000004';
  select computed_arrival into after_d from trip_stops where id = '11110000-0000-0000-0000-000000000002';
  assert after_d = before_d + 14, format('trip cascade failed: %s -> %s', before_d, after_d);
end $$;

-- Clearing the start date nulls stop dates rather than inventing them.
do $$
declare n int;
begin
  update goals set start_date = null where id = 'bbbbbbbb-0000-0000-0000-000000000004';
  select count(*) into n from trip_stops
   where trip_id = 'eeeeeeee-0000-0000-0000-000000000001' and computed_arrival is not null;
  assert n = 0, format('%s stops kept stale dates', n);
  update goals set start_date = current_date + 200 where id = 'bbbbbbbb-0000-0000-0000-000000000004';
end $$;

-- ---- zero-night stop ---------------------------------------------------------
do $$
declare s record;
begin
  insert into trip_stops (trip_id, sequence, name, nights)
  values ('eeeeeeee-0000-0000-0000-000000000001', 3, 'Airport connection', 0);
  select * into s from trip_stops where name = 'Airport connection';
  assert s.computed_arrival = s.computed_departure, 'zero-night stop should arrive and depart same day';
end $$;

-- ---- promotion ---------------------------------------------------------------
select set_config('request.jwt.claim.sub', '11111111-1111-1111-1111-111111111111', false);

do $$
declare v_id uuid; s record; si record;
begin
  select * into si from someday_items where title = 'Patagonia';

  v_id := app.promote_someday_to_stop(si.id, 'eeeeeeee-0000-0000-0000-000000000001', 4);

  select * into s from trip_stops where id = v_id;
  assert s.name = 'Patagonia', format('name not copied: %s', s.name);
  assert s.nights = 4, format('nights wrong: %s', s.nights);
  assert s.someday_item_id = si.id, 'link back to someday item missing';
  assert s.unsplash_photo_id = si.unsplash_photo_id, 'unsplash id not copied';
  assert s.unsplash_author_name is not null, 'attribution must survive promotion';
  assert s.estimated_cost_minor = si.rough_cost_minor, 'cost not copied';

  select * into si from someday_items where id = si.id;
  assert si.promoted_at is not null, 'someday item should be stamped promoted';
  assert si.deleted_at is null, 'promotion must not delete the original';
end $$;

-- ---- timeline integration ----------------------------------------------------
do $$
declare n int;
begin
  select count(*) into n from v_timeline_items where item_type = 'trip_stop';
  assert n >= 4, format('trip stops should appear on the timeline, got %s', n);

  select count(*) into n from v_timeline_items
   where item_type = 'trip_stop' and starts_on is null;
  assert n = 0, 'timeline trip stops must have dates';
end $$;

-- ---- progress views ----------------------------------------------------------
do $$
declare p record;
begin
  select * into p from v_someday_progress where user_id = '11111111-1111-1111-1111-111111111111';
  assert p.total_items >= 1, 'someday progress should count items';
  assert p.promoted_count >= 1, 'promoted count should reflect the promotion';
end $$;

rollback;
select 'TRIP SCHEDULING VERIFIED' as result;